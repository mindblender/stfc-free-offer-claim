{
  "manifest_version": 3,
  "name": "STFC Claim Free Offers",
  "version": "1.9.6",
  "description": "Automatically claims free offers on the STFC web store.",
  "browser_specific_settings": {
    "gecko": {
      "id": "stfc-claim-offers@mindblender.dev",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "theme_icons": [
      {
        "light": "icons/icon16.png",
        "dark":  "icons/icon16-white.png",
        "size":  16
      },
      {
        "light": "icons/icon48.png",
        "dark":  "icons/icon48-white.png",
        "size":  48
      }
    ]
  },
  "host_permissions": ["https://home.startrekfleetcommand.com/*"],
  "content_scripts": [
    {
      "matches": ["https://home.startrekfleetcommand.com/store*"],
      "js": ["content-claim.js"],
      "run_at": "document_idle"
    }
  ]
}
