{
  "manifest_version": 3,
  "name": "STFC Claim Free Offers",
  "version": "1.9.7",
  "description": "Automatically claims free offers on the STFC web store.",
  "browser_specific_settings": {
    "gecko": {
      "id": "stfc-claim-offers@mindblender.dev",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16":  "icons/icon16-green.png",
    "48":  "icons/icon48-green.png",
    "128": "icons/icon128-green.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16-green.png",
      "48": "icons/icon48-green.png"
    }
  },
  "host_permissions": ["https://home.startrekfleetcommand.com/*"],
  "content_scripts": [
    {
      "matches": ["https://home.startrekfleetcommand.com/store*"],
      "js": ["content-claim.js"],
      "run_at": "document_idle"
    }
  ]
}
